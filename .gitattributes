# NeuroSched .gitattributes
# Normalize line endings: store LF in git, checkout as-is on each platform

# Source files: store as LF
*.c     text eol=lf
*.h     text eol=lf
*.S     text eol=lf
*.ld    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf
Makefile text eol=lf
.gitignore text eol=lf

# Binary files: no line-ending conversion
*.o     binary
*.elf   binary
*.bin   binary
*.iso   binary
*.exe   binary
*.zip   binary
*.7z    binary
